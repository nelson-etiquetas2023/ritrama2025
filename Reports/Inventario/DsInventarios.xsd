                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT a.roll_id,a.part_number,b.product_name,a.Width,lenght, disponible, fecha_pro, fecha_recep, splice, Ubicacion,'Inic.' AS tipo_mov,largo_consumido,(lenght - largo_consumido) as largo_restante,CASE WHEN largo_consumido=0 THEN 'Completo' WHEN (lenght - largo_consumido)=0 THEN 'Agotado' ELSE 'Parcialmente Utilizado' END AS estado FROM MasterInic a LEFT JOIN producto b ON a.part_number = b.product_id where b.MasterRolls = 1 and a.disponible = 1 union SELECT a.rollid as roll_id,a.product_id as part_number,b.product_name,width,length,disponible=1,c.fecha_pro,c.fecha_recepcion as fecha_recep,splice,ubicacion,'Importacion' AS tipo_mov,a.largo_consumido,a.largo_restante,estado='Completo' FROM ItemsMateria a LEFT JOIN producto b ON a.product_id= b.product_id LEFT JOIN OrdenMateria c ON a.numero=c.numero WHERE a.type='Master'</CommandText>
